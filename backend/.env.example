# Google Gemini API Key (required for question generation and feedback)
GEMINI_API_KEY=

# Model to use for generation (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.5-flash-lite

# Default number of questions per assessment
QUESTION_COUNT=5

# Server-side cache TTL in seconds
CACHE_TTL_SECONDS=3600

# JWT secret for auth tokens (change in production)
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_EXPIRE_HOURS=72

# Comma-separated frontend origins (use * for dev; set your Render/Vercel URL in production)
CORS_ORIGINS=*

# SQLite path (Render: mount a disk at /var/data and set /var/data/app.db)
DATABASE_PATH=
